# VaaniCart AI Backend Environment Variables
APP_NAME=VaaniCart AI
ENVIRONMENT=development
PORT=8000
DEBUG=true

# LLM Configuration (supports "gemini", "openai", or "local")
# If no key is set, the system automatically runs the local intelligent heuristic shopping agent.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Prompt Versions
PROMPT_VERSION_INTENT=v1
PROMPT_VERSION_VOICE=v1
PROMPT_VERSION_RAG=v1

# Vector Search / RAG
RAG_TOP_K=4

# Product Catalog Provider ("mock" or "shopify")
PRODUCT_PROVIDER=mock
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
